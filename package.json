{
  "name": "miniappruntime-react-todo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/inline-dist.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync:harmony": "node scripts/sync-harmony.mjs",
    "typecheck": "tsc -b",
    "setup:harmony": "node scripts/harmony-cli.mjs install",
    "build:harmony": "npm run build && npm run sync:harmony && node scripts/harmony-cli.mjs build",
    "check": "npm run format:check && npm run lint && npm test && npm run check:harmony && npm run build",
    "init:harmony": "node scripts/init-harmony.mjs",
    "format": "prettier --write .",
    "lint:fix": "eslint . --fix",
    "test": "node --experimental-strip-types --test src/todos.test.ts scripts/harmony.test.mjs",
    "check:harmony": "node scripts/check-harmony.mjs",
    "format:check": "prettier --check .",
    "test:browser": "playwright test",
    "check:all": "npm run check && npm run test:browser",
    "build:test-site": "vite build --config tests/vite.config.ts"
  },
  "dependencies": {
    "@lcy453/miniapp-runtime-harmony-web-sdk": "0.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
